# Environment variables for the DePIN Accommodation Marketplace
#
# Copy this file to `.env.local` in each app and fill in real values.
# The frontend uses a simple mock auth provider; the Solana settings below
# target Devnet by default.

# ---------------------------------------------------------------------------
# apps/frontend/.env.local
# ---------------------------------------------------------------------------

# No Clerk needed for development - using simple mock auth provider

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------

# Public key used to verify JWTs sent as Bearer tokens.
# The default in apps/api/config.ts is a placeholder for local development only.
JWT_PUBLIC_KEY=

# Optional: override the Solana Devnet RPC endpoint used to verify escrows.
# Defaults to https://api.devnet.solana.com
SOLANA_RPC_URL=

# Optional: WalletConnect project id. WalletConnect is skipped without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# programs/depin
# ---------------------------------------------------------------------------

# Solana cluster configuration lives in programs/depin/Anchor.toml
# Provider wallet: ~/.config/solana/id.json